{
  "name": "staad-live-load-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build && electron electron/main.cjs",
    "test:browser": "node scripts/browser-check.mjs",
    "format": "prettier --write src scripts electron vite.config.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
